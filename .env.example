# WordPress REST API base (no trailing slash)
WP_API_BASE=https://themico.websage.lat/wp-json/wp/v2

# Shared secret for on-demand revalidation. Must match MICO_REVALIDATE_SECRET
# in the WordPress mu-plugin. Generate a random string.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# WordPress form-submission endpoint (mico-form-handler.php).
# Public (used in the browser), so it's NEXT_PUBLIC_.
NEXT_PUBLIC_WP_FORM_ENDPOINT=https://themico.websage.lat/wp-json/mico/v1/submit
